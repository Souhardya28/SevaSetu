# Copy to .env. Never commit real values.
# Mobile app (Expo exposes only EXPO_PUBLIC_* to the client)
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8000

# Backend (FastAPI), server-side only
LLM_PROVIDER=mock            # mock | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=mock      # mock | sentence-transformers | api
OCR_PROVIDER=mock            # mock | tesseract | cloud
STT_PROVIDER=mock            # mock | whisper | bhashini
SUPABASE_SERVICE_ROLE_KEY=   # never ship to the client
